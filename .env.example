# Public site URL — canonical URLs, Open Graph and sitemap.xml
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# MongoDB (Atlas → Connect → Drivers). Server-only: never prefix with NEXT_PUBLIC_.
# Also required at build time, because public pages are prerendered from the database.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="portfolio"

# Salt for hashing visitor IPs used by form rate limiting (any long random string).
IP_HASH_SALT="change-me-to-a-long-random-string"

# Cloudinary (Dashboard → API Keys). Server-only: never prefix with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-api-secret"
# Set after `npm run images:migrate` so built-in images load from Cloudinary (not a secret).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
